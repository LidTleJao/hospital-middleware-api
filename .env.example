# Copy to .env before running the stack:  cp .env.example .env
# .env is gitignored on purpose - never commit real secrets.

# ---- database
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital
POSTGRES_PORT=5432

# ---- http
# Host port that nginx listens on.
HTTP_PORT=8080
# Host port that maps straight to the API container (dev overlay only).
API_DEBUG_PORT=8081

# ---- application
# "debug" or "release"
GIN_MODE=release
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=24h

# ---- external hospital information system
HIS_BASE_URL=https://hospital-a.api.co.th
HIS_TIMEOUT=10s
