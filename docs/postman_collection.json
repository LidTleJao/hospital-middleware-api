{
  "info": {
    "name": "Hospital Middleware API",
    "description": "Staff signup/login and hospital-scoped patient search.\n\nRun the requests in order: Create staff -> Login (stores the token automatically) -> Patient search.\n\nSeeded hospitals: H001..H005. Seeded patients: 5 at H001, 2 at H002, 1 at H003.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Staff - create (H001)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"doc_a\",\n  \"password\": \"secret123\",\n  \"hospital\": \"H001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/create", "host": ["{{baseUrl}}"], "path": ["staff", "create"] }
      }
    },
    {
      "name": "Staff - create (H002)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"doc_b\",\n  \"password\": \"secret123\",\n  \"hospital\": \"H002\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/create", "host": ["{{baseUrl}}"], "path": ["staff", "create"] }
      }
    },
    {
      "name": "Staff - login (stores token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"doc_a\",\n  \"password\": \"secret123\",\n  \"hospital\": \"H001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/login", "host": ["{{baseUrl}}"], "path": ["staff", "login"] }
      }
    },
    {
      "name": "Staff - login (wrong password, expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"doc_a\",\n  \"password\": \"wrongpassword\",\n  \"hospital\": \"H001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/login", "host": ["{{baseUrl}}"], "path": ["staff", "login"] }
      }
    },
    {
      "name": "Patient - search by name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Somchai\",\n  \"page\": 1,\n  \"page_size\": 20\n}"
        },
        "url": { "raw": "{{baseUrl}}/patient/search", "host": ["{{baseUrl}}"], "path": ["patient", "search"] }
      }
    },
    {
      "name": "Patient - search all of my hospital",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/patient/search", "host": ["{{baseUrl}}"], "path": ["patient", "search"] }
      }
    },
    {
      "name": "Patient - search another hospital's national_id (expect [])",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"national_id\": \"1101700200666\"\n}" },
        "url": { "raw": "{{baseUrl}}/patient/search", "host": ["{{baseUrl}}"], "path": ["patient", "search"] }
      }
    },
    {
      "name": "Patient - search without a token (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/patient/search", "host": ["{{baseUrl}}"], "path": ["patient", "search"] }
      }
    },
    {
      "name": "Patient - import from HIS",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"id\": \"1101700200111\"\n}" },
        "url": { "raw": "{{baseUrl}}/patient/import", "host": ["{{baseUrl}}"], "path": ["patient", "import"] }
      }
    }
  ]
}
