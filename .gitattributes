# The stack is built and run inside Linux containers, so every file that a
# container reads must keep LF endings no matter which OS commits it.
* text=auto eol=lf

*.go        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.conf      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
.env.example text eol=lf

*.png binary
*.jpg binary
*.pdf binary
